<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SourceGit.ViewModels"
             x:Class="SourceGit.Views.SvnRepositoryToolbar"
             x:DataType="vm:SvnRepository">
  <Grid ColumnDefinitions="Auto,*,Auto" Margin="4,0">
    <StackPanel Grid.Column="0" Orientation="Horizontal">
      <Button Classes="icon_button" Width="32" Click="OnOpenInFileManager"
              ToolTip.Tip="{DynamicResource Text.Repository.Explore}"
              AutomationProperties.Name="{DynamicResource Text.Repository.Explore}">
        <Path Width="14" Height="14" Data="{StaticResource Icons.Explore}"/>
      </Button>
      <Button Classes="icon_button" Width="32" Click="OnOpenTerminal"
              ToolTip.Tip="{DynamicResource Text.Repository.Terminal}"
              AutomationProperties.Name="{DynamicResource Text.Repository.Terminal}">
        <Path Width="14" Height="14" Data="{StaticResource Icons.Terminal}"/>
      </Button>
      <TextBlock Margin="8,0" MaxWidth="140" TextTrimming="CharacterEllipsis" FontWeight="Bold" Text="{Binding ActiveTitle}"/>
    </StackPanel>

    <TextBlock Grid.Column="1" Margin="8,0,12,0" Text="{Binding FullPath}"
               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding FullPath}"
               Foreground="{DynamicResource Brush.FG2}"/>

    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
      <Button Classes="flat" Height="26" Padding="12,0" Content="{DynamicResource Text.SVN.Update}"
              IsEnabled="{Binding CanMutateWorkingCopy}" Click="OnUpdate"
              ToolTip.Tip="{DynamicResource Text.SVN.Update.Scope}"/>
      <Button Classes="flat" Height="26" Width="24" Content="▾" Click="OnUpdateMenu"
              IsEnabled="{Binding CanMutateWorkingCopy}" AutomationProperties.Name="{DynamicResource Text.SVN.Update.ToRevision}"/>
      <Button Classes="flat" Height="26" Padding="12,0" Margin="4,0" Content="{DynamicResource Text.SVN.Commit}"
              IsEnabled="{Binding CanMutateWorkingCopy}" Click="OnCommit"/>

      <Button Classes="flat" Height="26" Padding="12,0"
              Content="{DynamicResource Text.Cancel}" IsVisible="{Binding IsLoadingActive}" Click="OnCancel"/>
      <Button Classes="flat" Height="26" Padding="12,0"
              Content="{DynamicResource Text.SVN.Refresh}" ToolTip.Tip="{DynamicResource Text.SVN.RefreshTip}" IsEnabled="{Binding CanRefreshActive}" Click="OnRefresh"/>
    </StackPanel>
  </Grid>
</UserControl>
