<v:ChromelessWindow xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:v="using:SourceGit.Views"
                    x:Class="SourceGit.Views.SvnRepairDialog" x:Name="ThisControl"
                    Icon="/App.ico" Width="640" MinWidth="500" Height="540" MinHeight="420"
                    CanResize="True" CloseOnESC="False" WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="Auto,*,Auto">
    <Grid Grid.Row="0" Height="28" IsVisible="{Binding !#ThisControl.UseSystemWindowFrame}">
      <Border Background="{DynamicResource Brush.TitleBar}" BorderThickness="0,0,0,1"
              BorderBrush="{DynamicResource Brush.Border0}" PointerPressed="BeginMoveWindow"/>
      <TextBlock x:Name="DialogTitle" Classes="bold" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
      <v:CaptionButtons HorizontalAlignment="Right" IsCloseButtonOnly="True" IsVisible="{OnPlatform True, macOS=False}"/>
    </Grid>
    <ScrollViewer Grid.Row="1" Margin="16" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="10">
        <TextBlock Text="{DynamicResource Text.SVN.WorkingCopy}" FontWeight="Bold"/>
        <TextBlock x:Name="WorkingCopyPath" TextWrapping="Wrap" MaxLines="2" MaxHeight="42" TextTrimming="CharacterEllipsis"
                   ToolTip.Tip="{Binding #WorkingCopyPath.Text}" Foreground="{DynamicResource Brush.FG2}"/>
        <TextBlock Text="{DynamicResource Text.SVN.Repair.MissingSource}" FontWeight="Bold"/>
        <TextBox x:Name="SourcePath" IsReadOnly="True" AutomationProperties.Name="{DynamicResource Text.SVN.Repair.MissingSource}"/>
        <TextBlock Text="{DynamicResource Text.SVN.Repair.ExistingTarget}" FontWeight="Bold"/>
        <Grid ColumnDefinitions="*,Auto">
          <TextBox x:Name="TargetInput" MinHeight="28" TextChanged="OnTargetChanged"
                   Watermark="{DynamicResource Text.SVN.Repair.TargetHint}"
                   AutomationProperties.Name="{DynamicResource Text.SVN.Repair.ExistingTarget}"/>
          <Button x:Name="BrowseButton" Grid.Column="1" Classes="flat" Height="28" Padding="12,0" Margin="8,0,0,0"
                  Content="{DynamicResource Text.SVN.Repair.Browse}" Click="OnBrowse"/>
        </Grid>
        <Button x:Name="PrepareRepairButton" Classes="flat" Height="30" Padding="12,0" HorizontalAlignment="Left"
                Content="{DynamicResource Text.SVN.Repair.Review}" Click="OnPrepare"/>
        <TextBlock Text="{DynamicResource Text.SVN.PathOperation.Result}" FontWeight="Bold"/>
        <Border BorderThickness="1" BorderBrush="{DynamicResource Brush.Border1}" Background="{DynamicResource Brush.Contents}" Padding="8">
          <TextBlock x:Name="DestinationPreview" TextWrapping="Wrap" FontFamily="{DynamicResource Fonts.Monospace}" MinHeight="36"
                     AutomationProperties.Name="{DynamicResource Text.SVN.PathOperation.Result}"/>
        </Border>
        <TextBlock x:Name="RepairNotice" Text="{DynamicResource Text.SVN.Repair.RenameNotice}" TextWrapping="Wrap"
                   Foreground="{DynamicResource Brush.FG2}"/>
      </StackPanel>
    </ScrollViewer>
    <StackPanel Grid.Row="2" Margin="16,0,16,16" Spacing="6">
      <StackPanel x:Name="RepairErrorPanel" Spacing="4" IsVisible="False">
        <ScrollViewer MaxHeight="56" HorizontalScrollBarVisibility="Disabled">
          <TextBlock x:Name="RepairErrorMessage" TextWrapping="Wrap"/>
        </ScrollViewer>
        <Expander x:Name="RepairErrorDetailsExpander" Header="{DynamicResource Text.SVN.Connection.Details}" IsVisible="False">
          <TextBox x:Name="RepairErrorDetails" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="64"/>
        </Expander>
      </StackPanel>
      <TextBlock x:Name="RepairBusyMessage" Text="{DynamicResource Text.SVN.Repair.Applying}" IsVisible="False" Foreground="{DynamicResource Brush.FG2}"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button x:Name="ReloadRepairButton" Classes="flat" Height="30" MinWidth="80" Padding="12,0"
                Content="{DynamicResource Text.SVN.Changelist.Reload}" Click="OnReload"/>
        <Button x:Name="CancelRepairButton" Classes="flat" Height="30" MinWidth="80" Padding="12,0"
                Content="{DynamicResource Text.Cancel}" Click="OnCancel"/>
        <Button x:Name="ApplyRepairButton" Classes="flat primary" Height="30" MinWidth="80" Padding="12,0"
                Content="{DynamicResource Text.SVN.Repair.Rename}" Click="OnApply"/>
      </StackPanel>
    </StackPanel>
  </Grid>
</v:ChromelessWindow>
