<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SourceGit.ViewModels"
             xmlns:v="using:SourceGit.Views"
             xmlns:svn="using:SourceGit.Native"
             xmlns:c="using:SourceGit.Converters"
             x:Class="SourceGit.Views.SvnRepository"
             x:DataType="vm:SvnRepository"
             Loaded="OnLoaded">
  <Grid Margin="4,0,4,4" RowDefinitions="Auto,*">
    <TabControl x:Name="RepositoryTabs" Grid.Row="0" SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
      <TabItem Header="{DynamicResource Text.SVN.History}"/>
      <TabItem Header="{DynamicResource Text.SVN.WorkingCopy}"/>
    </TabControl>
    <Grid Grid.Row="1" IsVisible="{Binding !IsWorkingCopyTabActive}" Margin="4,0,4,4" Background="{DynamicResource Brush.Contents}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="3*" MinHeight="100"/>
        <RowDefinition Height="3"/>
        <RowDefinition Height="3*" MinHeight="190"/>
      </Grid.RowDefinitions>

      <StackPanel Grid.Row="0">
        <Border Padding="12,5" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Brush.Border0}">
          <TextBlock Text="{Binding Url}" TextTrimming="CharacterEllipsis"
                     Foreground="{DynamicResource Brush.FG2}" ToolTip.Tip="{Binding Url}"/>
        </Border>

        <ScrollViewer MaxHeight="180" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                      IsVisible="{Binding HasError}">
          <Border Margin="8" Padding="12,8" BorderThickness="1" BorderBrush="{DynamicResource Brush.Border1}"
                  Background="{DynamicResource Brush.Window}">
            <StackPanel Spacing="8">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Margin="0,0,12,0" Text="{Binding ErrorMessage}" TextWrapping="Wrap"/>
                <Button Grid.Column="1" Classes="flat" Height="26" Padding="12,0"
                        Content="{DynamicResource Text.SVN.Retry}" IsEnabled="{Binding CanRefresh}" Click="OnRetry"/>
              </Grid>
              <Expander Header="{DynamicResource Text.SVN.Connection.Details}" HorizontalAlignment="Stretch">
                <TextBox Text="{Binding ErrorDetails, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True"
                         TextWrapping="Wrap" MaxHeight="100" VerticalContentAlignment="Top"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"/>
              </Expander>

              <Grid IsVisible="{Binding NeedsCredentials}" RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,240,Auto,240,*">
                <TextBlock Grid.Row="0" Grid.ColumnSpan="5" FontWeight="Bold" Margin="0,0,0,8"
                           Text="{DynamicResource Text.SVN.Credentials}"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,8,0" Text="{DynamicResource Text.SVN.Username}"/>
                <TextBox Grid.Row="1" Grid.Column="1" Height="28" Text="{Binding Username, Mode=TwoWay}"
                         IsEnabled="{Binding !IsLoading}" AutomationProperties.Name="{DynamicResource Text.SVN.Username}"/>
                <TextBlock Grid.Row="1" Grid.Column="2" Margin="16,0,8,0" Text="{DynamicResource Text.SVN.Password}"/>
                <TextBox Grid.Row="1" Grid.Column="3" Height="28" Text="{Binding Password, Mode=TwoWay}" PasswordChar="●"
                         IsEnabled="{Binding !IsLoading}" AutomationProperties.Name="{DynamicResource Text.SVN.Password}"/>
                <Button Grid.Row="1" Grid.Column="4" Classes="flat primary" Height="28" Margin="12,0,0,0" Padding="12,0"
                        HorizontalAlignment="Left" Content="{DynamicResource Text.SVN.SignIn}"
                        IsEnabled="{Binding CanSignIn}" Click="OnSignIn"/>
                <Grid Grid.Row="2" Grid.ColumnSpan="5" Margin="0,8,0,0" ColumnDefinitions="Auto,*">
                  <CheckBox Grid.Column="0" Content="{DynamicResource Text.SVN.Remember}" IsChecked="{Binding Remember, Mode=TwoWay}"
                            IsEnabled="{Binding CanRemember}"/>
                  <TextBlock Grid.Column="1" Margin="12,0,0,0" Text="{Binding RememberHint}"
                             Foreground="{DynamicResource Brush.FG2}" TextWrapping="Wrap"/>
                </Grid>
              </Grid>
            </StackPanel>
          </Border>
        </ScrollViewer>
      </StackPanel>

      <Grid Grid.Row="1" RowDefinitions="*,32">
        <DataGrid x:Name="HistoryRevisions" Grid.Row="0" ContextRequested="OnHistoryContextRequested" ItemsSource="{Binding Revisions}" SelectedItem="{Binding SelectedRevision, Mode=TwoWay}"
                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                  CanUserSortColumns="False" CanUserReorderColumns="False" CanUserResizeColumns="True"
                  HeadersVisibility="Column" GridLinesVisibility="None" RowHeight="26" ColumnHeaderHeight="24"
                  Background="Transparent" BorderThickness="0" ScrollViewer.AllowAutoHide="False"
                  AutomationProperties.Name="{DynamicResource Text.SVN.History}">
          <DataGrid.Styles>
            <Style Selector="DataGridColumnHeader">
              <Setter Property="MinHeight" Value="24"/>
              <Setter Property="Background" Value="{DynamicResource Brush.Contents}"/>
            </Style>
            <Style Selector="DataGridCell">
              <Setter Property="Padding" Value="8,0"/>
            </Style>
          </DataGrid.Styles>
          <DataGrid.Columns>
            <DataGridTemplateColumn Width="104" MinWidth="104">
              <DataGridTemplateColumn.Header>
                <TextBlock Classes="table_header" Text="{DynamicResource Text.SVN.Revision}"/>
              </DataGridTemplateColumn.Header>
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate DataType="svn:SvnRevision">
                  <TextBlock Text="{Binding RevisionText}" FontFamily="{DynamicResource Fonts.Monospace}"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Width="*" MinWidth="220">
              <DataGridTemplateColumn.Header>
                <TextBlock Classes="table_header" Text="{DynamicResource Text.SVN.Message}"/>
              </DataGridTemplateColumn.Header>
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate DataType="svn:SvnRevision">
                  <TextBlock Text="{Binding Subject}" TextTrimming="CharacterEllipsis"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Width="140" MinWidth="100">
              <DataGridTemplateColumn.Header>
                <TextBlock Classes="table_header" Text="{DynamicResource Text.SVN.Author}"/>
              </DataGridTemplateColumn.Header>
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate DataType="svn:SvnRevision">
                  <TextBlock Text="{Binding Author}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Author}"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Width="180" MinWidth="150">
              <DataGridTemplateColumn.Header>
                <TextBlock Classes="table_header" Text="{DynamicResource Text.SVN.Date}"/>
              </DataGridTemplateColumn.Header>
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate DataType="svn:SvnRevision">
                  <TextBlock Text="{Binding DateText}" FontFeatures="+tnum" ToolTip.Tip="{Binding DateText}"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="0" Text="{DynamicResource Text.SVN.Empty}" IsVisible="{Binding IsEmpty}"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Brush.FG2}"/>

        <Border Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Brush.Border0}" Padding="8,2">
          <Grid ColumnDefinitions="Auto,Auto,*,Auto">
            <TextBlock Grid.Column="0" Text="{Binding LoadedText}" Foreground="{DynamicResource Brush.FG2}"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="16,0,0,0" IsVisible="{Binding IsLoading}">
              <v:LoadingIcon Width="16" Height="16"/>
              <TextBlock Text="{DynamicResource Text.SVN.Loading}" Foreground="{DynamicResource Brush.FG2}"/>
            </StackPanel>
            <Button Grid.Column="3" Classes="flat" Padding="12,0" Height="26"
                    Content="{DynamicResource Text.SVN.LoadMore}" IsEnabled="{Binding CanLoadMore}"
                    IsVisible="{Binding HasMore}" Click="OnLoadMore"/>
            <TextBlock Grid.Column="3" Text="{DynamicResource Text.SVN.AllLoaded}" Foreground="{DynamicResource Brush.FG2}">
              <TextBlock.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.And}">
                  <Binding Path="HasMore" Converter="{x:Static BoolConverters.Not}"/>
                  <Binding Path="IsLoading" Converter="{x:Static BoolConverters.Not}"/>
                  <Binding Path="HasError" Converter="{x:Static BoolConverters.Not}"/>
                  <Binding Path="Revisions.Count" Converter="{x:Static c:IntConverters.IsGreaterThanZero}"/>
                </MultiBinding>
              </TextBlock.IsVisible>
            </TextBlock>
          </Grid>
        </Border>
      </Grid>

      <GridSplitter Grid.Row="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    MinWidth="1" MinHeight="1" Background="Transparent" BorderBrush="{DynamicResource Brush.Border0}"
                    Focusable="True" AutomationProperties.Name="{DynamicResource Text.SVN.MessageSplitter}"/>

      <Grid Grid.Row="3" Margin="8" RowDefinitions="Auto,*">
        <TextBlock Grid.Row="0" Margin="4,0,4,8" FontWeight="Bold" Text="{Binding SelectionTitle}"
                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding SelectionTitle}" IsVisible="{Binding HasSelection}"/>
        <TabControl x:Name="HistoryDetailsTabs" Grid.Row="1" IsVisible="{Binding HasSelection}" SelectedIndex="0">
          <TabItem Header="{DynamicResource Text.SVN.Changes}">
            <Grid Margin="0,4,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="220"/>
                <ColumnDefinition Width="3"/>
                <ColumnDefinition Width="7*" MinWidth="340"/>
              </Grid.ColumnDefinitions>
              <Grid Grid.Column="0" RowDefinitions="Auto,Auto,*">
                <TextBlock Grid.Row="0" Margin="4,4,4,6" FontWeight="Bold" Text="{Binding PathsTitle}"
                           TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding PathsTitle}"/>
                <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" Margin="4,0,4,4" IsVisible="{Binding IsLoadingPaths}">
                  <v:LoadingIcon Grid.Column="0" Width="16" Height="16"/>
                  <TextBlock Grid.Column="1" Margin="6,0" Text="{DynamicResource Text.SVN.PathsLoading}"
                             TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Brush.FG2}"/>
                  <Button Grid.Column="2" Classes="flat" Height="24" Padding="8,0"
                          Content="{DynamicResource Text.SVN.Cancel}" Click="OnCancelPaths"/>
                </Grid>

                <DataGrid Grid.Row="2" ItemsSource="{Binding ChangedPaths}"
                          SelectedItem="{Binding SelectedChangedPath, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True"
                          SelectionMode="Single" CanUserSortColumns="False" CanUserReorderColumns="False" CanUserResizeColumns="True"
                          HeadersVisibility="Column" GridLinesVisibility="None" ColumnHeaderHeight="24"
                          Background="Transparent" BorderThickness="0" ScrollViewer.AllowAutoHide="False"
                          AutomationProperties.Name="{DynamicResource Text.SVN.Paths}">
                  <DataGrid.Styles>
                    <Style Selector="DataGridColumnHeader">
                      <Setter Property="MinHeight" Value="24"/>
                      <Setter Property="Background" Value="{DynamicResource Brush.Contents}"/>
                    </Style>
                    <Style Selector="DataGridCell">
                      <Setter Property="Padding" Value="8,3"/>
                    </Style>
                  </DataGrid.Styles>
                  <DataGrid.Columns>
                    <DataGridTemplateColumn Width="40" MinWidth="40">
                      <DataGridTemplateColumn.Header>
                        <TextBlock Classes="table_header" Text="" AutomationProperties.Name="{DynamicResource Text.SVN.Action}"
                                   ToolTip.Tip="{DynamicResource Text.SVN.Actions}"/>
                      </DataGridTemplateColumn.Header>
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="svn:SvnChangedPath">
                          <TextBlock Text="{Binding Action}" VerticalAlignment="Top" FontFamily="{DynamicResource Fonts.Monospace}"
                                     ToolTip.Tip="{Binding Action, Converter={x:Static c:SvnConverters.ActionText}}"
                                     AutomationProperties.Name="{Binding Action, Converter={x:Static c:SvnConverters.ActionText}}"/>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Width="*" MinWidth="160">
                      <DataGridTemplateColumn.Header>
                        <TextBlock Classes="table_header" Text="{DynamicResource Text.SVN.Path}"/>
                      </DataGridTemplateColumn.Header>
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="svn:SvnChangedPath">
                          <StackPanel Spacing="2">
                            <TextBlock Text="{Binding RelativePath}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Path}"/>
                            <StackPanel IsVisible="{Binding CopyFromPath, Converter={x:Static c:StringConverters.IsNotNullOrWhitespace}}">
                              <TextBlock Foreground="{DynamicResource Brush.FG2}">
                                <Run Text="{DynamicResource Text.SVN.CopiedFrom}"/>
                                <Run Text="{Binding CopyFromRevision, StringFormat='r{0}'}"/>
                              </TextBlock>
                              <TextBlock Text="{Binding CopyFromPath}" ToolTip.Tip="{Binding CopyFromPath}" Foreground="{DynamicResource Brush.FG2}" TextWrapping="Wrap"/>
                            </StackPanel>
                          </StackPanel>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                  </DataGrid.Columns>
                </DataGrid>

                <TextBlock Grid.Row="2" Margin="8" TextWrapping="Wrap" Text="{DynamicResource Text.SVN.PathsEmpty}" IsVisible="{Binding IsPathsEmpty}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Brush.FG2}"/>
                <ScrollViewer Grid.Row="2" IsVisible="{Binding HasPathsError}" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Background="{DynamicResource Brush.Contents}">
                  <StackPanel Margin="4" Spacing="4">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Grid.Column="0" Text="{Binding PathsErrorMessage}" TextWrapping="Wrap" Margin="0,0,8,0"/>
                      <Button Grid.Column="1" Classes="flat" Height="24" Padding="8,0" IsEnabled="{Binding CanRetryPaths}"
                              Content="{DynamicResource Text.SVN.Retry}" Click="OnRetryPaths"/>
                    </Grid>
                    <Expander Header="{DynamicResource Text.SVN.Connection.Details}"
                              IsVisible="{Binding PathsErrorDetails, Converter={x:Static c:StringConverters.IsNotNullOrWhitespace}}">
                      <TextBox Text="{Binding PathsErrorDetails, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True"
                               TextWrapping="Wrap" VerticalContentAlignment="Top"/>
                    </Expander>
                  </StackPanel>
                </ScrollViewer>
              </Grid>

              <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                            Background="Transparent" BorderBrush="{DynamicResource Brush.Border0}" Focusable="True"
                            AutomationProperties.Name="{DynamicResource Text.SVN.Diff.Splitter}"/>

              <Border Grid.Column="2" Margin="6,0,0,0" BorderThickness="1" CornerRadius="4"
                      BorderBrush="{DynamicResource Brush.Border2}" Background="{DynamicResource Brush.Window}" ClipToBounds="True">
                <Grid RowDefinitions="Auto,Auto,*">
                  <Border Grid.Row="0" Padding="4,0" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Brush.Border2}">
                    <Grid ColumnDefinitions="*,Auto" MinHeight="28">
                      <TextBlock Grid.Column="0" Margin="4,0" Text="{Binding DiffTitle}" ToolTip.Tip="{Binding DiffTitle}"
                                 TextTrimming="CharacterEllipsis" FontSize="11"/>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" IsVisible="{Binding IsTextDiff}">
                        <Button Classes="icon_button" Width="28" Click="OnGotoFirstChange"
                                ToolTip.Tip="{DynamicResource Text.Diff.First}" AutomationProperties.Name="{DynamicResource Text.Diff.First}">
                          <Path Width="12" Height="12" Stretch="Uniform" Data="{StaticResource Icons.Top}"/>
                        </Button>
                        <Button Classes="icon_button" Width="28" Click="OnGotoPrevChange"
                                ToolTip.Tip="{DynamicResource Text.Diff.Prev}" AutomationProperties.Name="{DynamicResource Text.Diff.Prev}">
                          <Path Width="12" Height="12" Stretch="Uniform" Data="{StaticResource Icons.Up}"/>
                        </Button>
                        <Button Classes="icon_button" Width="28" Click="OnGotoNextChange"
                                ToolTip.Tip="{DynamicResource Text.Diff.Next}" AutomationProperties.Name="{DynamicResource Text.Diff.Next}">
                          <Path Width="12" Height="12" Stretch="Uniform" Data="{StaticResource Icons.Down}"/>
                        </Button>
                        <Button Classes="icon_button" Width="28" Click="OnGotoLastChange"
                                ToolTip.Tip="{DynamicResource Text.Diff.Last}" AutomationProperties.Name="{DynamicResource Text.Diff.Last}">
                          <Path Width="12" Height="12" Stretch="Uniform" Data="{StaticResource Icons.Bottom}"/>
                        </Button>
                        <ToggleButton Classes="line_path" Width="28" Height="18" VerticalAlignment="Center"
                                      IsChecked="{Binding DiffModeSideBySide, Mode=TwoWay}"
                                      ToolTip.Tip="{DynamicResource Text.Diff.SideBySide}"
                                      AutomationProperties.Name="{DynamicResource Text.Diff.SideBySide}">
                          <Path Width="12" Height="12" Data="{StaticResource Icons.Layout}"/>
                        </ToggleButton>
                      </StackPanel>
                    </Grid>
                  </Border>

                  <ScrollViewer Grid.Row="1" MaxHeight="70" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                IsVisible="{Binding DiffBeforeText, Converter={x:Static c:StringConverters.IsNotNullOrWhitespace}}">
                    <StackPanel Margin="8,4" Spacing="2">
                      <TextBlock Text="{Binding DiffBeforeText}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.FG2}" FontSize="11"/>
                      <TextBlock Text="{Binding DiffAfterText}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.FG2}" FontSize="11"/>
                    </StackPanel>
                  </ScrollViewer>

                  <ContentControl x:Name="HistoryDiffPresenter" Grid.Row="2" Content="{Binding DiffContent}" IsVisible="{Binding IsTextDiff}">
                    <ContentControl.DataTemplates>
                      <DataTemplate DataType="vm:TextDiffContext">
                        <v:TextDiffView SelectedChunk="{Binding SelectedChunk, Mode=OneWay}"/>
                      </DataTemplate>
                    </ContentControl.DataTemplates>
                  </ContentControl>
                  <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                IsVisible="{Binding DiffNotice, Converter={x:Static c:StringConverters.IsNotNullOrWhitespace}}">
                    <TextBlock Margin="16" Text="{Binding DiffNotice}" TextWrapping="Wrap"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Brush.FG2}"/>
                  </ScrollViewer>
                  <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center"
                              VerticalAlignment="Center" IsVisible="{Binding IsLoadingDiff}">
                    <v:LoadingIcon Width="16" Height="16"/>
                    <TextBlock Text="{DynamicResource Text.SVN.Diff.Loading}" Foreground="{DynamicResource Brush.FG2}"/>
                    <Button Classes="flat" Height="24" Padding="8,0" Content="{DynamicResource Text.SVN.Cancel}" Click="OnCancelDiff"/>
                  </StackPanel>
                  <ScrollViewer Grid.Row="2" IsVisible="{Binding HasDiffError}" VerticalScrollBarVisibility="Auto"
                                HorizontalScrollBarVisibility="Disabled" Background="{DynamicResource Brush.Window}">
                    <StackPanel Margin="8" Spacing="8">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="{Binding DiffErrorMessage}" TextWrapping="Wrap" Margin="0,0,8,0"/>
                        <Button Grid.Column="1" Classes="flat" Height="24" Padding="8,0" IsEnabled="{Binding CanRetryDiff}"
                                Content="{DynamicResource Text.SVN.Retry}" Click="OnRetryDiff"/>
                      </Grid>
                      <Expander Header="{DynamicResource Text.SVN.Connection.Details}"
                                IsVisible="{Binding DiffErrorDetails, Converter={x:Static c:StringConverters.IsNotNullOrWhitespace}}">
                        <TextBox Text="{Binding DiffErrorDetails, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True"
                                 TextWrapping="Wrap" VerticalContentAlignment="Top"/>
                      </Expander>
                    </StackPanel>
                  </ScrollViewer>
                </Grid>
              </Border>
            </Grid>
          </TabItem>
          <TabItem Header="{DynamicResource Text.SVN.Message}">
            <TextBox Margin="0,4,0,0" Text="{Binding SelectedMessage, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True"
                     TextWrapping="Wrap" VerticalContentAlignment="Top" Padding="4"
                     Watermark="{DynamicResource Text.SVN.NoMessage}" AutomationProperties.Name="{DynamicResource Text.SVN.Message}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
          </TabItem>
        </TabControl>
        <TextBlock Grid.RowSpan="2" Text="{DynamicResource Text.SVN.SelectRevision}" IsVisible="{Binding !HasSelection}"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Brush.FG2}"/>
      </Grid>
    </Grid>
    <Grid Grid.Row="1" IsVisible="{Binding IsWorkingCopyTabActive}">
      <Grid DataContext="{Binding WorkingCopy}" x:DataType="vm:SvnWorkingCopy"
            Margin="8" RowDefinitions="Auto,Auto,*" Background="{DynamicResource Brush.Contents}">
        <Grid Grid.Row="0" Margin="4,0,4,8" ColumnDefinitions="*,Auto,Auto">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="{Binding Title}" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{Binding SelectionSummary}" Foreground="{DynamicResource Brush.FG2}"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="8,0" IsVisible="{Binding IsBusy}">
            <v:LoadingIcon Width="16" Height="16"/>
            <TextBlock Text="{Binding BusyMessage}" Foreground="{DynamicResource Brush.FG2}"/>
          </StackPanel>
          <Button x:Name="WorkingCopySelectedActions" Grid.Column="2" Classes="flat" Height="26" Padding="12,0" Margin="0,4,0,0"
                  Content="{DynamicResource Text.SVN.WorkingCopy.SelectedActions}" IsEnabled="{Binding CanSelectedActions}"
                  AutomationProperties.Name="{DynamicResource Text.SVN.WorkingCopy.SelectedActions}" Click="OnSelectedActions"/>
        </Grid>
        <StackPanel Grid.Row="1" Margin="4,0,4,8" Spacing="4">
          <StackPanel Spacing="4" IsVisible="{Binding HasActionError}">
            <ScrollViewer MaxHeight="90" HorizontalScrollBarVisibility="Disabled">
              <TextBlock Text="{Binding ActionErrorMessage}" TextWrapping="Wrap"/>
            </ScrollViewer>
            <Expander Header="{DynamicResource Text.SVN.Connection.Details}"
                      IsVisible="{Binding ActionErrorDetails, Converter={x:Static c:StringConverters.IsNotNullOrWhitespace}}">
              <TextBox Text="{Binding ActionErrorDetails, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True"
                       MaxHeight="100" TextWrapping="Wrap"/>
            </Expander>
          </StackPanel>
          <ScrollViewer MaxHeight="90" HorizontalScrollBarVisibility="Disabled"
                        IsVisible="{Binding ActionNotice, Converter={x:Static c:StringConverters.IsNotNullOrWhitespace}}">
            <TextBlock Text="{Binding ActionNotice}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.FG2}"/>
          </ScrollViewer>
          <Expander Header="{DynamicResource Text.SVN.Operation.Output}"
                    IsVisible="{Binding OperationOutput, Converter={x:Static c:StringConverters.IsNotNullOrWhitespace}}">
            <TextBox Text="{Binding OperationOutput, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True"
                     MaxHeight="160" TextWrapping="Wrap"/>
          </Expander>
        </StackPanel>
        <Grid Grid.Row="2">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="7*" MinWidth="250"/>
            <ColumnDefinition Width="3"/>
            <ColumnDefinition Width="13*" MinWidth="340"/>
          </Grid.ColumnDefinitions>
          <Grid Grid.Column="0">
            <DataGrid x:Name="WorkingCopyEntries" ItemsSource="{Binding Entries}"
                      IsEnabled="{Binding !IsBusy}" SelectionChanged="OnWorkingCopySelectionChanged"
                      ContextRequested="OnWorkingCopyContextRequested"
                      AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended"
                      CanUserSortColumns="False" CanUserReorderColumns="False" CanUserResizeColumns="True"
                      HeadersVisibility="Column" GridLinesVisibility="None" ColumnHeaderHeight="24"
                      Background="Transparent" BorderThickness="0" ScrollViewer.AllowAutoHide="False"
                      AutomationProperties.Name="{DynamicResource Text.SVN.WorkingCopy}">
              <DataGrid.Styles>
                <Style Selector="DataGridColumnHeader">
                  <Setter Property="MinHeight" Value="24"/>
                  <Setter Property="Background" Value="{DynamicResource Brush.Contents}"/>
                </Style>
                <Style Selector="DataGridCell">
                  <Setter Property="Padding" Value="8,5"/>
                </Style>
              </DataGrid.Styles>
              <DataGrid.Columns>
                <DataGridTemplateColumn Width="*" MinWidth="220">
                  <DataGridTemplateColumn.Header>
                    <TextBlock Classes="table_header" Text="{DynamicResource Text.SVN.Path}"/>
                  </DataGridTemplateColumn.Header>
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate DataType="vm:SvnWorkingCopyEntry">
                      <StackPanel Spacing="3">
                        <TextBlock Text="{Binding Path}" ToolTip.Tip="{Binding Path}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource Brush.FG2}" TextWrapping="Wrap"/>
                        <Border IsVisible="{Binding HasWarning}" Background="{DynamicResource Brush.Conflict}" Padding="5,1"
                                CornerRadius="2" HorizontalAlignment="Left">
                          <TextBlock Text="{DynamicResource Text.SVN.WorkingCopy.NeedsAttention}" FontSize="11"
                                     Foreground="{DynamicResource Brush.Conflict.Foreground}"/>
                        </Border>
                        <TextBlock Text="{Binding DetailsText}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.FG2}"
                                   IsVisible="{Binding DetailsText, Converter={x:Static c:StringConverters.IsNotNullOrWhitespace}}"/>
                      </StackPanel>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>
            <TextBlock Margin="16" Text="{DynamicResource Text.SVN.WorkingCopy.Clean}" IsVisible="{Binding IsEmpty}"
                       TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Brush.FG2}"/>
            <ScrollViewer IsVisible="{Binding HasError}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Background="{DynamicResource Brush.Contents}">
              <StackPanel Margin="8" Spacing="8">
                <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap"/>
                <Button Classes="flat" Height="26" Padding="12,0" HorizontalAlignment="Left" Content="{DynamicResource Text.SVN.Retry}"
                        IsEnabled="{Binding CanRefresh}" Click="OnRefreshWorkingCopy"/>
                <Expander Header="{DynamicResource Text.SVN.Connection.Details}"
                          IsVisible="{Binding ErrorDetails, Converter={x:Static c:StringConverters.IsNotNullOrWhitespace}}">
                  <TextBox Text="{Binding ErrorDetails, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True"
                           TextWrapping="Wrap" VerticalContentAlignment="Top"/>
                </Expander>
              </StackPanel>
            </ScrollViewer>
          </Grid>
          <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent"
                        BorderBrush="{DynamicResource Brush.Border0}" Focusable="True"
                        AutomationProperties.Name="{DynamicResource Text.SVN.WorkingCopy.Splitter}"/>
          <Border Grid.Column="2" Margin="6,0,0,0" BorderThickness="1" CornerRadius="4" ClipToBounds="True"
                  BorderBrush="{DynamicResource Brush.Border2}" Background="{DynamicResource Brush.Window}">
            <Grid RowDefinitions="Auto,Auto,Auto,*">
              <Border Grid.Row="0" Padding="8,4" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Brush.Border2}">
                <TextBlock Text="{Binding DiffTitle}" ToolTip.Tip="{Binding DiffTitle}" TextTrimming="CharacterEllipsis" FontSize="11" MinHeight="20"/>
              </Border>
              <TextBlock Grid.Row="1" Margin="8,6" Text="{Binding SelectionNotice}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.FG2}"
                         IsVisible="{Binding SelectionNotice, Converter={x:Static c:StringConverters.IsNotNullOrWhitespace}}"/>
              <ScrollViewer Grid.Row="2" MaxHeight="70" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                            IsVisible="{Binding DiffBeforeText, Converter={x:Static c:StringConverters.IsNotNullOrWhitespace}}">
                <StackPanel Margin="8,4" Spacing="2">
                  <TextBlock Text="{Binding DiffBeforeText}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.FG2}" FontSize="11"/>
                  <TextBlock Text="{Binding DiffAfterText}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.FG2}" FontSize="11"/>
                </StackPanel>
              </ScrollViewer>
              <Grid Grid.Row="3">
                <TabControl x:Name="WorkingCopyDiffTabs" IsVisible="{Binding HasSelection}">
                  <TabItem Header="{DynamicResource Text.SVN.WorkingCopy.Content}">
                    <Grid RowDefinitions="Auto,*">
                      <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="4" IsVisible="{Binding IsTextDiff}">
                        <Button Classes="icon_button" Width="28" Click="OnWorkingCopyGotoFirstChange" ToolTip.Tip="{DynamicResource Text.Diff.First}" AutomationProperties.Name="{DynamicResource Text.Diff.First}">
                          <Path Width="12" Height="12" Stretch="Uniform" Data="{StaticResource Icons.Top}"/>
                        </Button>
                        <Button Classes="icon_button" Width="28" Click="OnWorkingCopyGotoPrevChange" ToolTip.Tip="{DynamicResource Text.Diff.Prev}" AutomationProperties.Name="{DynamicResource Text.Diff.Prev}">
                          <Path Width="12" Height="12" Stretch="Uniform" Data="{StaticResource Icons.Up}"/>
                        </Button>
                        <Button Classes="icon_button" Width="28" Click="OnWorkingCopyGotoNextChange" ToolTip.Tip="{DynamicResource Text.Diff.Next}" AutomationProperties.Name="{DynamicResource Text.Diff.Next}">
                          <Path Width="12" Height="12" Stretch="Uniform" Data="{StaticResource Icons.Down}"/>
                        </Button>
                        <Button Classes="icon_button" Width="28" Click="OnWorkingCopyGotoLastChange" ToolTip.Tip="{DynamicResource Text.Diff.Last}" AutomationProperties.Name="{DynamicResource Text.Diff.Last}">
                          <Path Width="12" Height="12" Stretch="Uniform" Data="{StaticResource Icons.Bottom}"/>
                        </Button>
                        <ToggleButton Classes="line_path" Width="28" Height="18" VerticalAlignment="Center" IsChecked="{Binding DiffModeSideBySide, Mode=TwoWay}"
                                      ToolTip.Tip="{DynamicResource Text.Diff.SideBySide}" AutomationProperties.Name="{DynamicResource Text.Diff.SideBySide}">
                          <Path Width="12" Height="12" Data="{StaticResource Icons.Layout}"/>
                        </ToggleButton>
                      </StackPanel>
                      <ContentControl x:Name="WorkingCopyDiffPresenter" Grid.Row="1" Content="{Binding DiffContent}" IsVisible="{Binding IsTextDiff}">
                        <ContentControl.DataTemplates>
                          <DataTemplate DataType="vm:TextDiffContext">
                            <v:TextDiffView SelectedChunk="{Binding SelectedChunk, Mode=OneWay}"/>
                          </DataTemplate>
                        </ContentControl.DataTemplates>
                      </ContentControl>
                      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                    IsVisible="{Binding DiffNotice, Converter={x:Static c:StringConverters.IsNotNullOrWhitespace}}">
                        <TextBlock Margin="16" Text="{Binding DiffNotice}" TextWrapping="Wrap" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" Foreground="{DynamicResource Brush.FG2}"/>
                      </ScrollViewer>
                    </Grid>
                  </TabItem>
                  <TabItem Header="{DynamicResource Text.SVN.WorkingCopy.Properties}">
                    <Grid>
                      <TextBox Text="{Binding PropertyDiffContent, Mode=OneWay}" IsVisible="{Binding HasPropertyDiff}"
                               IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" VerticalContentAlignment="Top"
                               FontFamily="{DynamicResource Fonts.Monospace}" FontSize="{Binding Source={x:Static vm:Preferences.Instance}, Path=EditorFontSize}"
                               BorderThickness="0" Padding="8" Background="{DynamicResource Brush.Contents}"
                               ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"
                               AutomationProperties.Name="{DynamicResource Text.SVN.WorkingCopy.Properties}"/>
                      <TextBlock Margin="16" Text="{Binding PropertyNotice}" TextWrapping="Wrap" HorizontalAlignment="Center"
                                 VerticalAlignment="Center" Foreground="{DynamicResource Brush.FG2}" IsVisible="{Binding !HasPropertyDiff}"/>
                    </Grid>
                  </TabItem>
                </TabControl>
                <TextBlock Margin="16" Text="{DynamicResource Text.SVN.WorkingCopy.SelectFile}" IsVisible="{Binding !HasSelection}"
                           TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Brush.FG2}"/>
                <Border Background="{DynamicResource Brush.Window}" IsVisible="{Binding IsLoadingDiff}">
                  <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <v:LoadingIcon Width="16" Height="16"/>
                    <TextBlock Text="{DynamicResource Text.SVN.Diff.Loading}" Foreground="{DynamicResource Brush.FG2}"/>
                    <Button Classes="flat" Height="24" Padding="8,0" Content="{DynamicResource Text.SVN.Cancel}" Click="OnCancelWorkingCopyDiff"/>
                  </StackPanel>
                </Border>
                <ScrollViewer IsVisible="{Binding HasDiffError}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Background="{DynamicResource Brush.Window}">
                  <StackPanel Margin="8" Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Grid.Column="0" Text="{Binding DiffErrorMessage}" TextWrapping="Wrap" Margin="0,0,8,0"/>
                      <Button Grid.Column="1" Classes="flat" Height="24" Padding="8,0" IsEnabled="{Binding CanRetryDiff}"
                              Content="{DynamicResource Text.SVN.Retry}" Click="OnRetryWorkingCopyDiff"/>
                    </Grid>
                    <Expander Header="{DynamicResource Text.SVN.Connection.Details}"
                              IsVisible="{Binding DiffErrorDetails, Converter={x:Static c:StringConverters.IsNotNullOrWhitespace}}">
                      <TextBox Text="{Binding DiffErrorDetails, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True"
                               TextWrapping="Wrap" VerticalContentAlignment="Top"/>
                    </Expander>
                  </StackPanel>
                </ScrollViewer>
              </Grid>
            </Grid>
          </Border>
        </Grid>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
