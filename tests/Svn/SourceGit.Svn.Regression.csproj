    <Compile Include="../../src/Native/Svn.ChangedPaths.cs" Link="Production/Svn.ChangedPaths.cs" />
    <Compile Include="../../src/Native/Svn.Cache.cs" Link="Production/Svn.Cache.cs" />
    <Compile Include="../../src/Native/Svn.FileDiff.cs" Link="Production/Svn.FileDiff.cs" />
    <Compile Include="../../src/Native/Svn.Status.cs" Link="Production/Svn.Status.cs" />
    <Compile Include="../../src/Native/Svn.Actions.cs" Link="Production/Svn.Actions.cs" />
    <Compile Include="../../src/Native/Svn.Undo.cs" Link="Production/Svn.Undo.cs" />
    <Compile Include="../../src/Native/Svn.Operations.cs" Link="Production/Svn.Operations.cs" />
    <Compile Include="../../src/Native/Svn.Conflicts.cs" Link="Production/Svn.Conflicts.cs" />
  </ItemGroup>
</Project>
